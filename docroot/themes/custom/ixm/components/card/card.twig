<div class="card">
  <div class="card__container">
    <div class="card__header">
      {# Name #}
      {% if name|render|striptags|trim %}
        <h3 class="card__name">
          {{ name }}
        </h3>
      {% endif %}

      {# Position #}
      {% if position|render|striptags|trim %}
        <span class="card__position">
          {{ position }}
        </span>
      {% endif %}

      {% if image|render|striptags|trim %}
        <div class="card__image">
          <img alt="" src={{image|render|striptags|trim}} />
        </div>
      {% endif %}
    </div>

    {% if age|render|striptags|trim or location|render|striptags|trim or education|render|striptags|trim %}
      <div class="card__details">
        {# Age #}
        {% if age|render|striptags|trim %}
          <p class="card__details__container">
            <span class="card__details__label">
              {{ ageLabel }}
            </span>
            <span class="age">
              {{ age|render|striptags|trim }}
            </span>
          </p>
        {% endif %}

        {# Location #}
        {% if location|render|striptags|trim %}
          <p class="card__details__container">
            <span class="card__details__label">
              {{ locationLabel }}
            </span>
            <span class="location">
              {{ location|render|striptags|trim }}
            </span>
          </p>
        {% endif %}

        {# Education #}
        {% if education|render|striptags|trim %}
          <p class="card__details__container">
            <span class="card__details__label">
              {{ educationLabel }}
            </span>
            <span class="education">
              {{ education|render|striptags|trim }}
            </span>
          </p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>