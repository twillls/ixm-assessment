{{ attach_library('ixm/header') }}

<header class="position-sticky z-1 bg-white">
  <div class="bg-white w-100">
    <div class="container">

      {% set nav_attributes = create_attribute() %}
      {% set nav_classes = [
        'navbar',
        'navbar-expand-xl',
        'align-items-xl-center',
        'px-0',
        'py-0',
        'navbar-light',
      ] %}

      <nav {{ nav_attributes.addClass(nav_classes) }}>

        {# logo - change if needs to be dynamic. #}
        <a class="navbar-brand" href="{{ url('<front>') }}">
          {% include 'ixm:logo' with {
            logo_size: '200',
            logo_color: 'var(--bs-black)',
            start_color: '#f7931e',
            stop_color: '#ed1c24',
            version: '6',
            version_color: 'var(--bs-white)',
            title: 'Site logo'
          } %}

        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon">
            <svg width="26" height="18" viewBox="0 0 26 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1H25" stroke="#000" stroke-width="2" stroke-linecap="round"/>
              <path d="M1 9H25" stroke="black" stroke-width="2" stroke-linecap="round"/>
              <path d="M1 17H25" stroke="black" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
        </button>

        <div class="collapse navbar-collapse" id="navbarCollapse">
          {% if page.navigation %}
            <div>
              {{ page.navigation }}
            </div>
          {% endif %}
        </div>
      </nav>
    </div>
  </div>
</header>
