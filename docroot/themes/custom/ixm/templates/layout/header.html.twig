{{ attach_library('ixm/header') }}

<header class="position-sticky z-1 bg-white">
  <div class="bg-white">
    <div class="container">

      {% set nav_attributes = create_attribute() %}
      {% set nav_classes = [
        'navbar',
        'navbar-expand-xl',
        'align-items-xl-center',
        'px-0',
        'py-0',
        'navbar-light',
      ] %}

      <nav {{ nav_attributes.addClass(nav_classes) }}>

        {# logo - change if needs to be dynamic. #}
        <a class="navbar-brand" href="{{ url('<front>') }}">
          {% include 'ixm:logo' with {
            logo_size: '200',
            logo_color: 'var(--bs-black)',
            start_color: '#f7931e',
            stop_color: '#ed1c24',
            version: '6',
            version_color: 'var(--bs-white)',
            title: 'Site logo'
          } %}

        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarCollapse">
          {% if page.navigation %}
            <div>
              {{ page.navigation }}
            </div>
          {% endif %}
        </div>
      </nav>
    </div>
  </div>
</header>
